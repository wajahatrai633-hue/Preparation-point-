<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Study Hub Pro | PPSC FPSC NTS Preparation</title>

  <meta name="description"
        content="Study Hub Pro - PPSC, FPSC and NTS exam preparation platform with MCQ tests, revision and progress tracking.">

  <meta name="author" content="Rai Wajahat Nazir">

  <style>

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --primary: #2563eb;
      --primary-dark: #1d4ed8;
      --secondary: #0f172a;
      --bg: #f1f5f9;
      --card: #ffffff;
      --text: #0f172a;
      --muted: #64748b;
      --border: #e2e8f0;
      --success: #16a34a;
      --danger: #dc2626;
      --warning: #f59e0b;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
    }

    button,
    input,
    select,
    textarea {
      font-family: inherit;
    }

    button {
      cursor: pointer;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    /* ================= HEADER ================= */

    header {
      background: var(--secondary);
      color: white;
      position: sticky;
      top: 0;
      z-index: 1000;
    }

    .header-container {
      max-width: 1200px;
      margin: auto;
      padding: 15px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .logo {
      font-size: 23px;
      font-weight: bold;
    }

    .logo span {
      color: #60a5fa;
    }

    .owner-mini {
      font-size: 13px;
      color: #cbd5e1;
    }

    /* ================= NAVIGATION ================= */

    nav {
      background: white;
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 59px;
      z-index: 999;
    }

    .nav-container {
      max-width: 1200px;
      margin: auto;
      display: flex;
      gap: 5px;
      padding: 8px 15px;
      overflow-x: auto;
    }

    .nav-btn {
      border: none;
      background: transparent;
      color: var(--muted);
      padding: 10px 14px;
      border-radius: 9px;
      font-weight: bold;
      white-space: nowrap;
    }

    .nav-btn:hover,
    .nav-btn.active {
      background: #dbeafe;
      color: var(--primary);
    }

    /* ================= MAIN ================= */

    main {
      max-width: 1200px;
      margin: auto;
      padding: 25px 20px 60px;
    }

    .page {
      display: none;
    }

    .page.active {
      display: block;
    }

    /* ================= HERO ================= */

    .hero {
      background: linear-gradient(
        135deg,
        #1d4ed8,
        #4338ca
      );
      color: white;
      border-radius: 22px;
      padding: 40px;
      margin-bottom: 25px;
    }

    .hero-badge {
      display: inline-block;
      background: rgba(255,255,255,.15);
      padding: 6px 12px;
      border-radius: 30px;
      font-size: 13px;
      margin-bottom: 15px;
    }

    .hero h1 {
      font-size: 38px;
      margin-bottom: 10px;
    }

    .hero p {
      color: #dbeafe;
      max-width: 700px;
    }

    /* ================= BUTTONS ================= */

    .btn {
      border: none;
      padding: 12px 18px;
      border-radius: 10px;
      font-weight: bold;
      transition: .2s;
      margin-top: 15px;
    }

    .btn-primary {
      background: var(--primary);
      color: white;
    }

    .btn-primary:hover {
      background: var(--primary-dark);
    }

    .btn-light {
      background: white;
      color: var(--primary);
    }

    .btn-secondary {
      background: #e2e8f0;
      color: var(--text);
    }

    .btn-danger {
      background: var(--danger);
      color: white;
    }

    /* ================= CARDS ================= */

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 15px;
      margin-bottom: 30px;
    }

    .stat-card,
    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 20px;
    }

    .stat-icon {
      font-size: 28px;
    }

    .stat-value {
      font-size: 28px;
      font-weight: bold;
      margin-top: 5px;
    }

    .stat-label {
      color: var(--muted);
      font-size: 14px;
    }

    .section-title {
      font-size: 24px;
      margin-bottom: 16px;
    }

    /* ================= SUBJECTS ================= */

    .subject-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 15px;
    }

    .subject-card {
      background: white;
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 22px;
      transition: .2s;
    }

    .subject-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 25px rgba(15,23,42,.08);
    }

    .subject-icon {
      font-size: 35px;
      margin-bottom: 10px;
    }

    .subject-card p {
      color: var(--muted);
      font-size: 14px;
      margin-top: 7px;
    }

    /* ================= QUIZ SETUP ================= */

    .quiz-setup,
    .quiz-container,
    .result-card {
      max-width: 800px;
      margin: auto;
    }

    .quiz-setup {
      background: white;
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 30px;
    }

    .field {
      margin: 20px 0;
    }

    .field label {
      display: block;
      font-weight: bold;
      margin-bottom: 8px;
    }

    select {
      width: 100%;
      padding: 13px;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: white;
      font-size: 16px;
    }

    /* ================= QUIZ ================= */

    .quiz-top {
      background: white;
      border: 1px solid var(--border);
      border-radius: 15px;
      padding: 18px;
      margin-bottom: 15px;
    }

    .quiz-info {
      display: flex;
      justify-content: space-between;
      gap: 10px;
    }

    .timer {
      color: var(--danger);
      font-weight: bold;
      font-size: 20px;
    }

    .progress {
      height: 9px;
      background: #e2e8f0;
      border-radius: 20px;
      overflow: hidden;
      margin-top: 14px;
    }

    .progress-bar {
      height: 100%;
      width: 0%;
      background: var(--primary);
      transition: width .3s;
    }

    .question-card {
      background: white;
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 30px;
    }

    .question-subject {
      color: var(--primary);
      font-weight: bold;
      margin-bottom: 12px;
    }

    .question-text {
      font-size: 23px;
      font-weight: bold;
      margin-bottom: 25px;
    }

    .options {
      display: grid;
      gap: 12px;
    }

    .option {
      width: 100%;
      text-align: left;
      background: white;
      border: 2px solid var(--border);
      padding: 15px;
      border-radius: 11px;
      font-size: 16px;
    }

    .option:hover {
      border-color: var(--primary);
      background: #eff6ff;
    }

    .option.selected {
      border-color: var(--primary);
      background: #dbeafe;
    }

    .quiz-actions {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      margin-top: 25px;
    }

    /* ================= RESULT ================= */

    .result-card {
      background: white;
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 35px;
      text-align: center;
    }

    .result-icon {
      font-size: 60px;
    }

    .score {
      color: var(--primary);
      font-size: 55px;
      font-weight: bold;
      margin: 10px;
    }

    .result-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin: 25px 0;
    }

    .result-box {
      background: #f8fafc;
      border-radius: 12px;
      padding: 18px;
    }

    .result-box strong {
      display: block;
      font-size: 25px;
    }

    /* ================= REVISION ================= */

    .revision-card {
      background: white;
      border: 1px solid var(--border);
      border-radius: 15px;
      padding: 20px;
      margin-bottom: 12px;
    }

    .correct-answer {
      color: var(--success);
      font-weight: bold;
      margin-top: 10px;
    }

    .explanation {
      color: var(--muted);
      font-size: 14px;
      margin-top: 8px;
    }

    /* ================= CONTACT ================= */

    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    .contact-item {
      background: white;
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 22px;
    }

    .contact-icon {
      font-size: 30px;
      margin-bottom: 8px;
    }

    .contact-item h3 {
      margin-bottom: 5px;
    }

    .contact-item p {
      color: var(--muted);
    }

    .contact-link {
      color: var(--primary);
      font-weight: bold;
      word-break: break-word;
    }

    /* ================= ABOUT ================= */

    .about-card {
      background: white;
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 28px;
      margin-bottom: 18px;
    }

    .about-card p {
      color: var(--muted);
      margin-top: 10px;
    }

    .owner-box {
      background: linear-gradient(
        135deg,
        #eff6ff,
        #eef2ff
      );
      border-radius: 16px;
      padding: 25px;
      margin-top: 20px;
    }

    .owner-name {
      font-size: 25px;
      font-weight: bold;
      color: var(--primary);
    }

    /* ================= FOOTER ================= */

    footer {
      background: var(--secondary);
      color: #cbd5e1;
      padding: 35px 20px;
      text-align: center;
    }

    footer h2 {
      color: white;
      margin-bottom: 8px;
    }

    footer p {
      margin: 5px 0;
    }

    .footer-links {
      margin: 15px 0;
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 18px;
    }

    .footer-links a {
      color: #93c5fd;
    }

    .footer-owner {
      color: white;
      font-weight: bold;
    }

    /* ================= MOBILE ================= */

    @media(max-width:900px) {

      .stats-grid {
        grid-template-columns: repeat(2,1fr);
      }

      .subject-grid {
        grid-template-columns: repeat(2,1fr);
      }

    }

    @media(max-width:600px) {

      .header-container {
        flex-direction: column;
        align-items: flex-start;
      }

      nav {
        top: 90px;
      }

      main {
        padding: 18px 12px 40px;
      }

      .hero {
        padding: 25px 20px;
      }

      .hero h1 {
        font-size: 28px;
      }

      .stats-grid,
      .subject-grid,
      .contact-grid {
        grid-template-columns: 1fr 1fr;
      }

      .question-card,
      .quiz-setup,
      .result-card,
      .about-card {
        padding: 20px;
      }

      .question-text {
        font-size: 20px;
      }

      .result-grid {
        grid-template-columns: 1fr;
      }

      .quiz-actions {
        flex-direction: column;
      }

      .quiz-actions button {
        width: 100%;
      }

    }

  </style>
</head>


