<script>

  /* ==================================================
     QUESTION BANK
  ================================================== */

  const questionBank = [

    {
      subject: "Pakistan Studies",
      question: "Who was the first Governor-General of Pakistan?",
      options: [
        "Liaquat Ali Khan",
        "Muhammad Ali Jinnah",
        "Iskander Mirza",
        "Ayub Khan"
      ],
      answer: 1,
      explanation:
        "Muhammad Ali Jinnah was the first Governor-General of Pakistan."
    },

    {
      subject: "Pakistan Studies",
      question: "Pakistan came into being on:",
      options: [
        "23 March 1940",
        "14 August 1947",
        "15 August 1947",
        "11 September 1948"
      ],
      answer: 1,
      explanation:
        "Pakistan became independent on 14 August 1947."
    },

    {
      subject: "Pakistan Studies",
      question: "What is the capital of Pakistan?",
      options: [
        "Lahore",
        "Karachi",
        "Islamabad",
        "Peshawar"
      ],
      answer: 2,
      explanation:
        "Islamabad is the capital of Pakistan."
    },

    {
      subject: "Pakistan Studies",
      question: "The Pakistan Resolution was passed at:",
      options: [
        "Lahore",
        "Karachi",
        "Delhi",
        "Dhaka"
      ],
      answer: 0,
      explanation:
        "The Lahore Resolution was passed at Lahore in 1940."
    },

    {
      subject: "Computer",
      question: "What does CPU stand for?",
      options: [
        "Central Processing Unit",
        "Computer Personal Unit",
        "Central Program Utility",
        "Control Processing User"
      ],
      answer: 0,
      explanation:
        "CPU stands for Central Processing Unit."
    },

    {
      subject: "Computer",
      question: "Which shortcut is commonly used to copy selected text?",
      options: [
        "Ctrl + X",
        "Ctrl + C",
        "Ctrl + V",
        "Ctrl + Z"
      ],
      answer: 1,
      explanation:
        "Ctrl + C is commonly used to copy selected content."
    },

    {
      subject: "Computer",
      question: "What does HTML stand for?",
      options: [
        "HyperText Markup Language",
        "HighText Machine Language",
        "Hyper Tool Markup Link",
        "Home Tool Markup Language"
      ],
      answer: 0,
      explanation:
        "HTML stands for HyperText Markup Language."
    },

    {
      subject: "English",
      question: "Choose the synonym of 'Brave'.",
      options: [
        "Coward",
        "Weak",
        "Courageous",
        "Lazy"
      ],
      answer: 2,
      explanation:
        "Courageous means brave."
    },

    {
      subject: "English",
      question: "Which word is a noun?",
      options: [
        "Beautiful",
        "Quickly",
        "Honesty",
        "Run"
      ],
      answer: 2,
      explanation:
        "Honesty is an abstract noun."
    },

    {
      subject: "English",
      question: "Choose the correct sentence.",
      options: [
        "He go to school.",
        "He going to school.",
        "He goes to school.",
        "He gone school."
      ],
      answer: 2,
      explanation:
        "With 'He' in simple present tense, we use 'goes'."
    },

    {
      subject: "General Knowledge",
      question: "Which is the largest province of Pakistan by area?",
      options: [
        "Punjab",
        "Sindh",
        "Balochistan",
        "Khyber Pakhtunkhwa"
      ],
      answer: 2,
      explanation:
        "Balochistan is the largest province of Pakistan by area."
    },

    {
      subject: "General Knowledge",
      question: "Which planet is known as the Red Planet?",
      options: [
        "Venus",
        "Mars",
        "Jupiter",
        "Mercury"
      ],
      answer: 1,
      explanation:
        "Mars is commonly known as the Red Planet."
    }

  ];


  /* ==================================================
     VARIABLES
  ================================================== */

  let quizQuestions = [];

  let currentQuestion = 0;

  let userAnswers = [];

  let timeLeft = 300;

  let timerInterval = null;


  /* ==================================================
     PAGE NAVIGATION
  ================================================== */

  const pages =
    document.querySelectorAll(".page");

  const navButtons =
    document.querySelectorAll(".nav-btn");


  function openPage(pageId) {

    pages.forEach(function(page) {

      page.classList.remove("active");

    });


    const target =
      document.getElementById(pageId);


    if (target) {

      target.classList.add("active");

    }


    navButtons.forEach(function(button) {

      button.classList.remove("active");

      if (
        button.dataset.page === pageId
      ) {

        button.classList.add("active");

      }

    });


    window.scrollTo({
      top: 0,
      behavior: "smooth"
    });


    if (pageId === "revision") {

      loadRevision();

    }


    if (pageId === "progress") {

      updateProgress();

    }

  }


  navButtons.forEach(function(button) {

    button.addEventListener(
      "click",
      function() {

        openPage(
          button.dataset.page
        );

      }
    );

  });


  /* ==================================================
     START BUTTONS
  ================================================== */

  document
    .getElementById("heroStartBtn")
    .addEventListener(
      "click",
      function() {

        openPage("quizSetup");

      }
    );


  document
    .getElementById("startQuizBtn")
    .addEventListener(
      "click",
      startQuiz
    );


  /* ==================================================
     START QUIZ
  ================================================== */

  function startQuiz() {

    const selectedSubject =
      document.getElementById(
        "subjectSelect"
      ).value;


    if (
      selectedSubject === "all"
    ) {

      quizQuestions =
        [...questionBank];

    } else {

      quizQuestions =
        questionBank.filter(
          function(question) {

            return (
              question.subject ===
              selectedSubject
            );

          }
        );

    }


    quizQuestions.sort(
      function() {

        return Math.random() - .5;

      }
    );


    quizQuestions =
      quizQuestions.slice(0,10);


    currentQuestion = 0;


    userAnswers =
      new Array(
        quizQuestions.length
      ).fill(null);


    timeLeft = 300;


    openPage("quizPage");


    startTimer();

    renderQuestion();

  }


  /* ==================================================
     TIMER
  ================================================== */

  function startTimer() {

    clearInterval(
      timerInterval
    );


    updateTimer();


    timerInterval =
      setInterval(
        function() {

          timeLeft--;

          updateTimer();


          if (
            timeLeft <= 0
          ) {

            clearInterval(
              timerInterval
            );

            finishQuiz();

          }

        },
        1000
      );

  }


  function updateTimer() {

    const minutes =
      Math.floor(
        timeLeft / 60
      );


    const seconds =
      timeLeft % 60;


    document.getElementById(
      "timer"
    ).textContent =
      String(minutes).padStart(2,"0")
      +
      ":"
      +
      String(seconds).padStart(2,"0");

  }


  /* ==================================================
     RENDER QUESTION
  ================================================== */

  function renderQuestion() {

    const question =
      quizQuestions[currentQuestion];


    document.getElementById(
      "questionCounter"
    ).textContent =
      "Question "
      +
      (currentQuestion + 1)
      +
      " / "
      +
      quizQuestions.length;


    document.getElementById(
      "questionSubject"
    ).textContent =
      question.subject;


    document.getElementById(
      "questionText"
    ).textContent =
      question.question;


    document.getElementById(
      "quizProgress"
    ).style.width =
      (
        (
          (currentQuestion + 1)
          /
          quizQuestions.length
        ) * 100
      ) + "%";


    const container =
      document.getElementById(
        "optionsContainer"
      );


    container.innerHTML = "";


    question.options.forEach(
      function(option,index) {

        const button =
          document.createElement(
            "button"
          );


        button.className =
          "option";


        if (
          userAnswers[
            currentQuestion
          ] === index
        ) {

          button.classList.add(
            "selected"
          );

        }


        button.textContent =
          String.fromCharCode(
            65 + index
          )
          +
          ". "
          +
          option;


        button.addEventListener(
          "click",
          function() {

            userAnswers[
              currentQuestion
            ] = index;

            renderQuestion();

          }
        );


        container.appendChild(
          button
        );

      }
    );


    document.getElementById(
      "previousBtn"
    ).disabled =
      currentQuestion === 0;


    document.getElementById(
      "nextBtn"
    ).textContent =
      currentQuestion ===
      quizQuestions.length - 1
      ?
      "Finish Test ✓"
      :
      "Next →";

  }


  /* ==================================================
     PREVIOUS
  ================================================== */

  document
    .getElementById("previousBtn")
    .addEventListener(
      "click",
      function() {

        if (
          currentQuestion > 0
        ) {

          currentQuestion--;

          renderQuestion();

        }

      }
    );


  /* ==================================================
     NEXT
  ================================================== */

  document
    .getElementById("nextBtn")
    .addEventListener(
      "click",
      function() {

        if (
          currentQuestion
          <
          quizQuestions.length - 1
        ) {

          currentQuestion++;

          renderQuestion();

        } else {

          finishQuiz();

        }

      }
    );


  /* ==================================================
     FINISH QUIZ
  ================================================== */

  function finishQuiz() {

    clearInterval(
      timerInterval
    );


    let correct = 0;

    let wrong = 0;

    let skipped = 0;


    quizQuestions.forEach(
      function(question,index) {

        const answer =
          userAnswers[index];


        if (
          answer === null
        ) {

          skipped++;

        }
        else if (
          answer === question.answer
        ) {

          correct++;

        }
        else {

          wrong++;

        }

      }
    );


    const total =
      quizQuestions.length;


    const percentage =
      Math.round(
        (correct / total) * 100
      );


    const oldTests =
      Number(
        localStorage.getItem(
          "sh_tests"
        ) || 0
      );


    const oldTotal =
      Number(
        localStorage.getItem(
          "sh_total"
        ) || 0
      );


    const oldBest =
      Number(
        localStorage.getItem(
          "sh_best"
        ) || 0
      );


    localStorage.setItem(
      "sh_tests",
      oldTests + 1
    );


    localStorage.setItem(
      "sh_total",
      oldTotal + percentage
    );


    if (
      percentage > oldBest
    ) {

      localStorage.setItem(
        "sh_best",
        percentage
      );

    }


    saveWrongQuestions();


    document.getElementById(
      "finalScore"
    ).textContent =
      percentage + "%";


    document.getElementById(
      "correctAnswers"
    ).textContent =
      correct;


    document.getElementById(
      "wrongAnswers"
    ).textContent =
      wrong;


    document.getElementById(
      "skippedAnswers"
    ).textContent =
      skipped;


    let message;


    if (
      percentage >= 80
    ) {

      message =
        "Excellent! 🔥 Keep it up.";

    }
    else if (
      percentage >= 60
    ) {

      message =
        "Good effort! Keep practicing.";

    }
    else {

      message =
        "Keep studying. You can improve.";

    }


    document.getElementById(
      "resultMessage"
    ).textContent =
      message;


    updateDashboard();


    openPage("resultPage");

  }


  /* ==================================================
     WRONG QUESTIONS
  ================================================== */

  function saveWrongQuestions() {

    let wrongQuestions =
      JSON.parse(
        localStorage.getItem(
          "sh_wrong_questions"
        ) || "[]"
      );


    quizQuestions.forEach(
      function(question,index) {

        if (
          userAnswers[index]
          !==
          question.answer
        ) {

          const exists =
            wrongQuestions.some(
              function(item) {

                return (
                  item.question ===
                  question.question
                );

              }
            );


          if (!exists) {

            wrongQuestions.push(
              question
            );

          }

        }

      }
    );


    localStorage.setItem(
      "sh_wrong_questions",
      JSON.stringify(
        wrongQuestions
      )
    );

  }


  /* ==================================================
     REVISION
  ================================================== */

  function loadRevision() {

    const container =
      document.getElementById(
        "revisionContainer"
      );


    const wrongQuestions =
      JSON.parse(
        localStorage.getItem(
          "sh_wrong_questions"
        ) || "[]"
      );


    if (
      wrongQuestions.length === 0
    ) {

      container.innerHTML = `
        <div class="card"
             style="text-align:center;color:#64748b;">
          ابھی کوئی wrong question نہیں۔
          <br><br>
          Test دینے کے بعد غلط سوالات یہاں save ہوں گے۔
        </div>
      `;

      return;

    }


    container.innerHTML = "";


    wrongQuestions.forEach(
      function(question,index) {

        const card =
          document.createElement(
            "div"
          );


        card.className =
          "revision-card";


        card.innerHTML = `

          <div style="
            color:#2563eb;
            font-weight:bold;
            font-size:13px;
          ">
            ${question.subject}
          </div>

          <h3 style="margin-top:7px;">
            ${index + 1}.
            ${question.question}
          </h3>

          <div class="correct-answer">
            ✓ Correct Answer:
            ${question.options[question.answer]}
          </div>

          <div class="explanation">
            ${question.explanation}
          </div>

        `;


        container.appendChild(
          card
        );

      }
    );

  }


  /* ==================================================
     DASHBOARD
  ================================================== */

  function updateDashboard() {

    const tests =
      Number(
        localStorage.getItem(
          "sh_tests"
        ) || 0
      );


    const best =
      Number(
        localStorage.getItem(
          "sh_best"
        ) || 0
      );


    const total =
      Number(
        localStorage.getItem(
          "sh_total"
        ) || 0
      );


    const average =
      tests > 0
      ?
      Math.round(
        total / tests
      )
      :
      0;


    document.getElementById(
      "totalTests"
    ).textContent =
      tests;


    document.getElementById(
      "bestScore"
    ).textContent =
      best + "%";


    document.getElementById(
      "averageScore"
    ).textContent =
      average + "%";

  }


  /* ==================================================
     PROGRESS
  ================================================== */

  function updateProgress() {

    const best =
      Number(
        localStorage.getItem(
          "sh_best"
        ) || 0
      );


    document.getElementById(
      "overallProgressText"
    ).textContent =
      best + "%";


    document.getElementById(
      "overallProgressBar"
    ).style.width =
      best + "%";

  }


  /* ==================================================
     RETRY
  ================================================== */

  document
    .getElementById("retryBtn")
    .addEventListener(
      "click",
      function() {

        openPage("quizSetup");

      }
    );


  /* ==================================================
     DASHBOARD
  ================================================== */

  document
    .getElementById("dashboardBtn")
    .addEventListener(
      "click",
      function() {

        openPage("dashboard");

      }
    );


  /* ==================================================
     RESET
  ================================================== */

  document
    .getElementById("resetBtn")
    .addEventListener(
      "click",
      function() {

        const confirmReset =
          confirm(
            "Are you sure you want to reset all progress?"
          );


        if (!confirmReset) {

          return;

        }


        localStorage.removeItem(
          "sh_tests"
        );

        localStorage.removeItem(
          "sh_best"
        );

        localStorage.removeItem(
          "sh_total"
        );

        localStorage.removeItem(
          "sh_wrong_questions"
        );


        updateDashboard();

        updateProgress();

        loadRevision();


        alert(
          "All progress has been reset."
        );

      }
    );


  /* ==================================================
     INITIALIZE
  ================================================== */

  updateDashboard();

  updateProgress();

</script>

